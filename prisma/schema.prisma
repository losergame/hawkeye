generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RecommendationAction {
  BUY
  HOLD
  SELL
}

enum AlertChannel {
  EMAIL
  DISCORD
  TELEGRAM
  IN_APP
}

enum AlertStatus {
  ACTIVE
  PAUSED
  TRIGGERED
}

enum TransactionSide {
  BUY
  SELL
}

// ── Signal Performance Tracker ────────────────────────────────────────────────

enum SignalStatus {
  PENDING
  TRIGGERED
  TARGET_HIT
  STOPPED_OUT
  EXPIRED
}

model ScannerSignal {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticker          String
  companyName     String       @map("company_name")
  setupType       String       @map("setup_type")

  // Entry levels (all Decimal for precision)
  entryPrice      Decimal      @map("entry_price")      @db.Decimal(18, 4)
  stopLoss        Decimal      @map("stop_loss")        @db.Decimal(18, 4)
  takeProfit1     Decimal      @map("take_profit_1")    @db.Decimal(18, 4)
  takeProfit2     Decimal      @map("take_profit_2")    @db.Decimal(18, 4)
  riskReward      Decimal      @map("risk_reward")      @db.Decimal(6, 3)

  // Metadata at generation time
  confidenceScore Int          @map("confidence_score")
  slMethod        String?      @map("sl_method")
  tp1Method       String?      @map("tp1_method")

  // Lifecycle
  status          SignalStatus @default(PENDING)
  generatedAt     DateTime     @map("generated_at")
  expiresAt       DateTime     @map("expires_at")

  // Outcome fields (populated as signal progresses)
  triggeredAt     DateTime?    @map("triggered_at")
  triggeredPrice  Decimal?     @map("triggered_price") @db.Decimal(18, 4)
  resolvedAt      DateTime?    @map("resolved_at")
  resolvedPrice   Decimal?     @map("resolved_price")  @db.Decimal(18, 4)
  actualReturn    Decimal?     @map("actual_return")   @db.Decimal(10, 4)
  actualRR        Decimal?     @map("actual_rr")       @db.Decimal(6, 3)
  isSimulated     Boolean      @default(false)          @map("is_simulated")

  createdAt       DateTime     @default(now())          @map("created_at")
  updatedAt       DateTime     @updatedAt               @map("updated_at")

  // Dedup: same ticker + setupType within 7 days = same signal
  @@unique([ticker, setupType, generatedAt])
  @@index([ticker, status])
  @@index([status, expiresAt])
  @@index([generatedAt(sort: Desc)])
  @@map("scanner_signals")
}

model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String             @unique
  name              String?
  riskProfile       String             @default("balanced") @map("risk_profile")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  watchlists        Watchlist[]
  portfolios        Portfolio[]
  stockAlerts       StockAlert[]
  aiRecommendations AiRecommendation[]
  transactions      Transaction[]

  @@map("users")
}

model Watchlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  symbol    String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([symbol])
  @@map("watchlists")
}

model Portfolio {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  symbol       String
  shares       Decimal  @db.Decimal(18, 6)
  averageCost  Decimal  @map("average_cost") @db.Decimal(18, 4)
  targetWeight Decimal? @map("target_weight") @db.Decimal(6, 3)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([symbol])
  @@map("portfolios")
}

model StockAlert {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  symbol     String
  channel    AlertChannel @default(IN_APP)
  status     AlertStatus  @default(ACTIVE)
  condition  String
  threshold  Decimal?     @db.Decimal(18, 4)
  message    String?
  triggeredAt DateTime?   @map("triggered_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol, status])
  @@map("stock_alerts")
}

model AiRecommendation {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?              @map("user_id") @db.Uuid
  symbol            String
  action            RecommendationAction
  riskScore         Int                  @map("risk_score")
  bullishConfidence Int                  @map("bullish_confidence")
  bearishConfidence Int                  @map("bearish_confidence")
  shortTermTrend    String               @map("short_term_trend")
  reasoning         Json
  model             String
  createdAt         DateTime             @default(now()) @map("created_at")
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([symbol, createdAt])
  @@map("ai_recommendations")
}

model Transaction {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  symbol    String
  side      TransactionSide
  shares    Decimal         @db.Decimal(18, 6)
  price     Decimal         @db.Decimal(18, 4)
  fees      Decimal         @default(0) @db.Decimal(18, 4)
  tradedAt  DateTime        @map("traded_at")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tradedAt])
  @@index([symbol])
  @@map("transactions")
}

model MarketNews {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  symbol         String?
  headline       String
  source         String
  url            String?
  sentimentScore Decimal? @map("sentiment_score") @db.Decimal(5, 2)
  publishedAt    DateTime @map("published_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([symbol, publishedAt])
  @@map("market_news")
}
