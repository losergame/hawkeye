# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI Responses API, kept server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Market data providers. The app runs with mock data when these are empty.
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Supabase + Prisma
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_ai_dashboard?schema=public"
DIRECT_URL=

# Alert channels
DISCORD_WEBHOOK_URL=

# Daily email summaries can be wired to Resend, SendGrid, Postmark, etc.
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
