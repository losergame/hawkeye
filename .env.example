# ════════════════════════════════════════════════════════════════
# Hawkeye — Required Environment Variables
# Copy to .env.local and fill in every value before running.
# NEVER commit .env.local to git.
# ════════════════════════════════════════════════════════════════

# ── Authentication (NextAuth) ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-32-char-random-string
# Your Vercel deployment URL (no trailing slash). Use http://localhost:3000 locally.
NEXTAUTH_URL=https://your-app.vercel.app

# ── Login Credentials ─────────────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=replace-with-strong-password

# ── Cron Job Secret ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Vercel sends "Authorization: Bearer <CRON_SECRET>" on every cron invocation.
CRON_SECRET=replace-with-random-hex-string

# ── Market Data — Finnhub ─────────────────────────────────────────────────────
# Free tier: 60 req/min — https://finnhub.io
FINNHUB_API_KEY=

# Optional: enables real-time WebSocket prices in the browser.
# If unset, falls back to 12-second HTTP polling.
NEXT_PUBLIC_FINNHUB_API_KEY=

# ── Market Data — Polygon.io (optional candle fallback) ──────────────────────
POLYGON_API_KEY=

# ── Persistence — Google Sheets ───────────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# Full key with literal \n for newlines:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ── Notifications — Discord (optional) ───────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Database — Supabase / PostgreSQL (optional) ───────────────────────────────
# Google Sheets is the primary data layer. Only needed for Supabase features.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
